      "Bash(uvx --help)",
      "Bash(uvx --python 3.13 bigquery-mcp --help)",
      "Bash(SSL_CERT_FILE={{HOME}}/{{ORG_CA_CERT}} uvx --python 3.13 bigquery-mcp --project {{GCP_PROJECT}} --location US --key-file {{HOME}}/github.com/{{ORG_REPO}}/etc/{{GCP_KEY_FILE}})",
