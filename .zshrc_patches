# Workaround: zsh 5.9 + zsh-syntax-highlighting 0.8.0
# ${(kv)options[@]} が ZLE 補完コンテキストで奇数要素を返すバグの回避
# TODO: zsh-syntax-highlighting の upstream 修正後に削除
if (( $+functions[_zsh_highlight] )) && (( ! $+functions[_zsh_highlight_orig] )); then
  functions[_zsh_highlight_orig]="$functions[_zsh_highlight]"
  _zsh_highlight() { _zsh_highlight_orig "$@" 2>/dev/null; }
fi

# Workaround: claude-code cask は Developer ID 署名済みだが未 notarize のため、
# brew が付与する com.apple.quarantine で macOS Gatekeeper がダイアログを出す。
# Homebrew 6.x では --no-quarantine が削除されているため、upgrade/install/reinstall 直後に
# claude バイナリの quarantine を除去する（起動経路に依存せず、claude-code のみに限定）。
# TODO: Anthropic が notarization 対応したら削除。
brew() {
  command brew "$@"
  local ret=$?
  case "$1" in
    upgrade|install|reinstall)
      local b=/opt/homebrew/bin/claude
      if [[ -e "$b" ]] && xattr "$b" 2>/dev/null | grep -q com.apple.quarantine; then
        xattr -d com.apple.quarantine "$b" 2>/dev/null
      fi
      ;;
  esac
  return $ret
}

# Workaround: prezto directory モジュールが NOCLOBBER を設定するため、
# cmux のシム書き込み `_cmux_install_cli_command_shim`（> をプレーンに使用、>| 非使用）が
# 既存 shim に対して "file exists" 警告を出す。cmux ペイン内でのみ CLOBBER を有効化して抑止する
# （通常ターミナルでは NOCLOBBER の安全策を維持）。
# TODO: cmux 統合が `>|` に修正されたら削除。
[[ -n "${CMUX_SHELL_INTEGRATION:-}" ]] && setopt CLOBBER
