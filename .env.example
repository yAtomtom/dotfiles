# Organization / project specific values
# Copy this file to .env and fill in your values:
#   cp .env.example .env

ORG_REPO="your-org/your-repo"
GCP_PROJECT="your-gcp-project-id"
GCP_KEY_FILE="your-service-account-key.json"
ORG_CA_CERT="your-org-ca.pem"
SLACK_MCP_NAME="your-slack-mcp-server-name"
SLACK_TEST_CHANNEL="channel-name (channel-id)"
WIN_NOTES_DIR="/mnt/c/Users/<WindowsUser>/.claude/notes"
