# Ghostty shell functions

# スクロールバックから最後のコマンド出力を抽出してコピー
# Cmd+Shift+Y (write_screen_file:copy -> この関数) で使用
# ref: https://github.com/kawarimidoll/dotfiles/blob/master/.config/sh/settings.sh
copy_last_command_output_from_ghostty_scrollback() {
  local file
  file="$(pbpaste)"
  if [[ ! -f "$file" ]]; then
    echo "Error: File not found: $file" >&2
    return 1
  fi
  perl -ne '
    push @lines, $_;
    END {
      pop @lines; pop @lines;
      for ($i = $#lines; $i >= 0; $i--) {
        if ($lines[$i] =~ /❯/) {
          print @lines[$i..$#lines];
          last;
        }
      }
    }
  ' "$file" | pbcopy
  echo "Copied last command output!"
}
