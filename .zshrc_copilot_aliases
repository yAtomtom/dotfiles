copilot_base() {
  local args=(
    --allow-tool "shell(git:*)"
    --allow-tool "shell(ls:*)"
    --allow-tool "shell(pwd:*)"
    --allow-tool "shell(cat:*)"
    --allow-tool "shell(head:*)"
    --allow-tool "shell(tail:*)"
    --allow-tool "shell(wc:*)"
    --allow-tool "shell(rg:*)"
    --allow-tool "shell(find:*)"
    --allow-tool "shell(sed:*)"
    --allow-tool "shell(awk:*)"
    --allow-tool "shell(echo:*)"
    --allow-tool "shell(printf:*)"
    --allow-tool "shell(whoami:*)"
    --allow-tool "shell(date:*)"
    --deny-tool "shell(rm -rf:*)"
    --deny-tool "shell(rm -r:*)"
    --deny-tool "shell(rm:*)"
    --deny-tool "shell(sudo:*)"
    --deny-tool "shell(chmod 777:*)"
    --deny-tool "shell(chmod 7*:*)"
    --deny-tool "shell(chmod 6*:*)"
    --deny-tool "shell(chown:*)"
    --deny-tool "shell(mkfs:*)"
    --deny-tool "shell(dd:*)"
    --deny-tool "shell(> /dev:*)"
    --deny-tool "shell(shutdown:*)"
    --deny-tool "shell(reboot:*)"
    --deny-tool "shell(poweroff:*)"
    --deny-tool "shell(halt:*)"
    --deny-tool "shell(init 0:*)"
    --deny-tool "shell(kill -9:*)"
    --deny-tool "shell(killall:*)"
    --deny-tool "shell(pkill:*)"
    --deny-tool "shell(fdisk:*)"
    --deny-tool "shell(parted:*)"
    --deny-tool "shell(wipefs:*)"
    --deny-tool "shell(diskutil:*)"
    --deny-tool "shell(mount:*)"
    --deny-tool "shell(umount:*)"
    --deny-tool "shell(cryptsetup:*)"
    --deny-tool "shell(git push:*)"
    --deny-tool "shell(git commit:*)"
    --deny-tool "shell(git reset:*)"
    --deny-tool "shell(git rebase:*)"
    --deny-tool "shell(git clean:*)"
    --deny-tool "shell(git checkout --:*)"
    --deny-tool "shell(npm uninstall:*)"
    --deny-tool "shell(npm remove:*)"
    --deny-tool "shell(yarn remove:*)"
    --deny-tool "shell(pnpm remove:*)"
    --deny-tool "shell(pip uninstall:*)"
    --deny-tool "shell(pip3 uninstall:*)"
    --deny-tool "shell(gem uninstall:*)"
    --deny-tool "shell(bundle remove:*)"
    --deny-tool "shell(brew uninstall:*)"
    --deny-tool "shell(apt remove:*)"
    --deny-tool "shell(apt purge:*)"
    --deny-tool "shell(yum remove:*)"
    --deny-tool "shell(dnf remove:*)"
    --deny-tool "shell(pacman -R:*)"
    --deny-tool "shell(nc:*)"
    --deny-tool "shell(ncat:*)"
    --deny-tool "shell(socat:*)"
    --deny-tool "shell(telnet:*)"
    --deny-tool "shell(psql:*)"
    --deny-tool "shell(mysql:*)"
    --deny-tool "shell(mongod:*)"
    --deny-tool "shell(mongo:*)"
    --deny-tool "shell(mongosh:*)"
    --deny-tool "shell(redis-cli:*)"
    --deny-tool "shell(cqlsh:*)"
    --deny-tool "shell(aql:*)"
    --deny-tool "shell(docker rm:*)"
    --deny-tool "shell(docker rmi:*)"
    --deny-tool "shell(docker system prune:*)"
    --deny-tool "shell(kubectl delete:*)"
    --deny-tool "shell(helm uninstall:*)"
    --deny-tool "shell(curl:*)"
    --deny-tool "shell(wget:*)"
    --deny-tool "shell(ssh:*)"
    --deny-tool "shell(scp:*)"
    --deny-tool "shell(sftp:*)"
    --deny-tool "shell(rsync:*)"
    --deny-tool "shell(ftp:*)"
    --deny-tool "shell(tftp:*)"
    --deny-tool "shell(aws:*)"
    --deny-tool "shell(gsutil:*)"
    --deny-tool "shell(gcloud:*)"
    --deny-tool "shell(az:*)"
  )
  # プロジェクト対応 dotfiles ディレクトリの導出（claude() と同一ロジック）
  local repo_name dotfiles_dir=""
  repo_name=$(basename "$(git remote get-url origin 2>/dev/null)" .git) 2>/dev/null || true
  if [[ -n "$repo_name" && "$repo_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    dotfiles_dir="$HOME/github.com/yAtomtom/${repo_name}-dotfiles"
  fi

  # プロジェクトルート直下の symlink ターゲットを cage -allow に追加
  local extra_allows=()
  for link in ./*(@N); do
    local target="${link:A}"
    if [[ -n "$target" && -d "$target" && "$target" != "$PWD"* ]]; then
      extra_allows+=(-allow "$target")
    fi
  done

  if [[ -n "$dotfiles_dir" && -d "$dotfiles_dir" ]]; then
    CAGE_DOTFILES_DIR="$dotfiles_dir" \
      command cage -config "$HOME/.config/cage/presets.yml" "${extra_allows[@]}" copilot "${args[@]}" "$@"
  else
    command cage -config "$HOME/.config/cage/presets.yml" "${extra_allows[@]}" copilot "${args[@]}" "$@"
  fi
}

# copilot-safe
copilot-s() {
  copilot_base \
    --add-dir "$HOME/copilot-sandbox" \
    "$@"
}

# copilot (standard)
copilot() {
  copilot_base \
    --add-dir ./ \
    --add-dir "$HOME/copilot-sandbox" \
    "$@"
}

copilot-m() {
  copilot_base \
    --add-dir ./ \
    --add-dir app \
    --add-dir lib \
    --add-dir spec \
    --add-dir engines \
    --add-dir doc \
    --add-dir script \
    --add-dir "$HOME/copilot-sandbox" \
    "$@"
}
